# Dominio raíz de la aplicación
APP_BASE_PATH=/

# Puerto público del contenedor en el servidor
APP_PORT=50541

NODE_ENV=production
PORT=3000
DB_PATH=/app/data/database.sqlite

# CORS y Google OAuth
CORS_ORIGIN=https://kahoot-builder.jcanas.es
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://kahoot-builder.jcanas.es/api/auth/google/callback

# Genera valores largos y aleatorios para producción
JWT_SECRET=cambia-este-secreto
JWT_REFRESH_SECRET=cambia-este-secreto-de-refresh
COOKIE_SECRET=cambia-este-secreto-de-cookies
